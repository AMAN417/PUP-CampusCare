# Server Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api/campuscare

# Data Provider Mode: 'memory' or 'supabase'
DATA_PROVIDER=memory

# Supabase Configuration (Required when DATA_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend URL — used to build the redirect link inside password-reset emails.
# Development default: http://localhost:5173  (used automatically when NODE_ENV=development)
# PRODUCTION REQUIRED: must be set explicitly — the server will refuse to start if this
# resolves to localhost while NODE_ENV=production.
# Example for production: FRONTEND_URL=https://pup-campus-care.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional: override the full reset-password redirect URL.
# Defaults to "${FRONTEND_URL}/#/reset-password" when not set.
# RESET_PASSWORD_REDIRECT_URL=https://pup-campus-care.vercel.app/#/reset-password
